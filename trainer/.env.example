# Compass (OpenAI-compatible) settings for the trainer. Copy to .env in this
# directory on the GPU backend and set real values there; never commit .env.
# Used by the optional dataset advisor, the model-picking agent, and Compass
# models in benchmarks. ADVISOR_BASE_URL must be
# https://compass.llm.shopee.io/compass-api/v1
ADVISOR_BASE_URL=
ADVISOR_API_KEY=
ADVISOR_MODEL=gpt-4.1-mini

# Local automatic evaluator (must already be cached on the GPU backend).
# Fixed for a workflow; no dataset answers are sent to a hosted service.
EVALUATOR_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional Paperclip control plane (https://github.com/paperclipai/paperclip).
# In Paperclip, create an agent with adapterType "http" and adapterConfig
#   {"url": "http://127.0.0.1:8000/paperclip/heartbeat",
#    "headers": {"Authorization": "Bearer <PAPERCLIP_WEBHOOK_SECRET>"}}
# and start Paperclip with PAPERCLIP_HTTP_ADAPTER_PRIVATE_ENDPOINT_ALLOWLIST=http://127.0.0.1:8000.
# PAPERCLIP_API_KEY is that agent's key (POST /api/agents/{agentId}/keys).
# Issues assigned to the agent carry the POST /workflow/runs JSON in their description.
PAPERCLIP_WEBHOOK_SECRET=
PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_API_KEY=
